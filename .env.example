# Public Inco AI — copy to .env next to docker-compose.yml

# Host port published to the world (map → container)
INCO_PUBLISH_PORT=8787

# Listen port inside the container (many PaaS set PORT for you)
PORT=8787

# Model (smaller = faster / less RAM)
INCO_MODEL=qwen2.5:1.5b
# INCO_MODEL=qwen2.5:0.5b

# CORS — * or comma-separated origins (https://thenionic.com,http://localhost:3000)
CORS_ORIGIN=*
